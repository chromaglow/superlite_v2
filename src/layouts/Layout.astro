---
import "../styles/global.css";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { navBarLinks, identity, socialLinks } from "../config";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
---

<script>
  // Lightbox
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement;

  let lightboxImages: HTMLImageElement[] = [];
  let lightboxIndex = 0;

  function showLightboxImage(index: number) {
    const img = lightboxImages[index];
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxIndex = index;
    lightboxPrev.style.visibility = index === 0 ? 'hidden' : 'visible';
    lightboxNext.style.visibility = index === lightboxImages.length - 1 ? 'hidden' : 'visible';
  }

  function closeLightbox() {
    lightbox.style.display = 'none';
    lightboxImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('[data-lightbox], article img')) {
      e.preventDefault();
      e.stopPropagation();
      lightboxImages = Array.from(document.querySelectorAll('[data-lightbox], article img')) as HTMLImageElement[];
      const index = lightboxImages.indexOf(target as HTMLImageElement);
      lightbox.style.display = 'flex';
      showLightboxImage(index >= 0 ? index : 0);
    }
  });

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxIndex > 0) showLightboxImage(lightboxIndex - 1);
  });

  lightboxNext.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxIndex < lightboxImages.length - 1) showLightboxImage(lightboxIndex + 1);
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft' && lightboxIndex > 0) showLightboxImage(lightboxIndex - 1);
    if (e.key === 'ArrowRight' && lightboxIndex < lightboxImages.length - 1) showLightboxImage(lightboxIndex + 1);
  });

  // Phone number copy
  const navPhoneLink = document.querySelector('header a[href^="tel:"]') as HTMLAnchorElement | null;
  if (navPhoneLink) {
    navPhoneLink.addEventListener('click', (e) => {
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (!isMobile) {
        e.preventDefault();
        navigator.clipboard.writeText('+1 (415) 335-9911').then(() => {
          const rect = navPhoneLink.getBoundingClientRect();
          const tip = document.createElement('span');
          tip.textContent = 'Copied!';
          tip.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${rect.left + rect.width / 2}px;transform:translateX(-50%);background:#333;color:#fff;font-size:12px;padding:3px 8px;border-radius:4px;pointer-events:none;z-index:9999;transition:opacity 0.3s`;
          document.body.appendChild(tip);
          setTimeout(() => { tip.style.opacity = '0'; }, 1500);
          setTimeout(() => { tip.remove(); }, 1800);
        });
      }
    });
  }
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/superlite_v2/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
  </head>
  <body>
    <header class="sticky top-0 z-50 bg-black">
      <div class="px-6 py-4 max-w-2xl mx-auto">

        <!-- Single row: Logo (desktop only) + nav links + social icons (desktop only) -->
        <div class="flex items-center">

          <!-- Logo: desktop only -->
          <a href="/superlite_v2/" class="hidden sm:block shrink-0 mr-6">
            <Image
              src={identity.logo}
              alt={"Logo"}
              width={50}
              height={50}
              class="w-[50px] h-[50px] object-cover rounded-full"
            />
          </a>

          <!-- Nav links: always visible. Mobile: justify-between (fills width). Desktop: justify-start with gap. -->
          <nav class="flex-1">
            <ul class="flex items-center justify-between sm:justify-start sm:gap-2">
              {
                navBarLinks.map((link) => (
                  <li>
                    <a
                      class="block px-2 py-2 text-sm sm:px-4 sm:text-base rounded-lg hover:bg-gray-bg opacity-100 sm:opacity-60 hover:opacity-100 transition-all whitespace-nowrap"
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <!-- Social icons: desktop only -->
          <div class="hidden sm:flex gap-4 ml-4 shrink-0">
            {
              socialLinks.map((link) => (
                <a
                  href={link.url}
                  target={link.external ? "_blank" : "_self"}
                  class="block p-2 opacity-60 hover:opacity-100 transition-opacity"
                  aria-label={link.title}
                >
                  <Icon name={link.icon} width={20} height={20} />
                </a>
              ))
            }
          </div>
        </div>

        <!-- Row 2: Social icons (mobile only), staggered under nav words via justify-around -->
        <div class="flex sm:hidden justify-around pt-1 pb-2">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target={link.external ? "_blank" : "_self"}
                class="block p-2 opacity-60 hover:opacity-100 transition-opacity"
                aria-label={link.title}
              >
                <Icon name={link.icon} width={20} height={20} />
              </a>
            ))
          }
        </div>

      </div>
    </header>
    <main class="mb-32">
      <slot />
    </main>
    <footer></footer>

    <!-- Lightbox overlay -->
    <div id="lightbox" style="display:none" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/90 p-4">
      <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none select-none cursor-pointer px-2">&#8249;</button>
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg cursor-zoom-out" />
      <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none select-none cursor-pointer px-2">&#8250;</button>
    </div>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap");

  html {
    font-family: "Inter", sans-serif;
    background: #000000;
  }

  * {
    -webkit-font-smoothing: antialiased;
    color: white;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  .hover-underline {
    text-decoration: underline 1px rgba(0, 0, 0, 0);
    text-underline-offset: 5px;
    transition: text-decoration-color 300ms;
  }

  .post:hover .hover-underline {
    text-decoration-color: rgba(255, 255, 255, 1);
  }

  article img {
    cursor: zoom-in;
  }
</style>
