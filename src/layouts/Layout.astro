---
import "../styles/global.css";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { navBarLinks, identity, socialLinks } from "../config";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
---

<script>
  // Lightbox
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement;

  let lightboxImages: HTMLImageElement[] = [];
  let lightboxIndex = 0;

  function showLightboxImage(index: number) {
    const img = lightboxImages[index];
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxIndex = index;
    lightboxPrev.style.visibility = index === 0 ? 'hidden' : 'visible';
    lightboxNext.style.visibility = index === lightboxImages.length - 1 ? 'hidden' : 'visible';
  }

  function closeLightbox() {
    lightbox.style.display = 'none';
    lightboxImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('[data-lightbox], article img')) {
      e.preventDefault();
      e.stopPropagation();
      lightboxImages = Array.from(document.querySelectorAll('[data-lightbox], article img')) as HTMLImageElement[];
      const index = lightboxImages.indexOf(target as HTMLImageElement);
      lightbox.style.display = 'flex';
      showLightboxImage(index >= 0 ? index : 0);
    }
  });

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxIndex > 0) showLightboxImage(lightboxIndex - 1);
  });

  lightboxNext.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightboxIndex < lightboxImages.length - 1) showLightboxImage(lightboxIndex + 1);
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft' && lightboxIndex > 0) showLightboxImage(lightboxIndex - 1);
    if (e.key === 'ArrowRight' && lightboxIndex < lightboxImages.length - 1) showLightboxImage(lightboxIndex + 1);
  });

  // Phone number copy
  const navPhoneLink = document.querySelector('header a[href^="tel:"]') as HTMLAnchorElement | null;
  if (navPhoneLink) {
    navPhoneLink.addEventListener('click', (e) => {
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (!isMobile) {
        e.preventDefault();
        navigator.clipboard.writeText('+1 (415) 335-9911').then(() => {
          const rect = navPhoneLink.getBoundingClientRect();
          const tip = document.createElement('span');
          tip.textContent = 'Copied!';
          tip.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${rect.left + rect.width / 2}px;transform:translateX(-50%);background:#333;color:#fff;font-size:12px;padding:3px 8px;border-radius:4px;pointer-events:none;z-index:9999;transition:opacity 0.3s`;
          document.body.appendChild(tip);
          setTimeout(() => { tip.style.opacity = '0'; }, 1500);
          setTimeout(() => { tip.remove(); }, 1800);
        });
      }
    });
  }

  // Hamburger menu
  const navToggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const mobileNav = document.getElementById('mobile-nav') as HTMLElement | null;
  const iconMenu  = document.getElementById('icon-menu')  as HTMLElement | null;
  const iconClose = document.getElementById('icon-close') as HTMLElement | null;

  navToggle?.addEventListener('click', () => {
    const isOpen = !mobileNav!.classList.contains('hidden');
    mobileNav!.classList.toggle('hidden');
    iconMenu!.style.display  = isOpen ? '' : 'none';
    iconClose!.style.display = isOpen ? 'none' : '';
    navToggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
  </head>
  <body>
    <header class="sticky top-0 z-50 bg-black">
      <div class="px-6 py-4 max-w-2xl mx-auto">

        <!-- Main row: Logo (desktop) + Nav (desktop) + Hamburger (mobile) + Social (desktop) -->
        <div class="flex items-center">

          <!-- Nav links: desktop only -->
          <nav class="hidden sm:flex flex-1">
            <ul class="flex items-center justify-start gap-2">
              {
                navBarLinks.map((link, i) => (
                  <li>
                    <a
                      class={`block py-2 text-base rounded-lg hover:bg-gray-bg opacity-60 hover:opacity-100 transition-all whitespace-nowrap ${i === 0 ? 'pr-4' : 'px-4'}`}
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <!-- Hamburger button: mobile only -->
          <button
            id="nav-toggle"
            class="sm:hidden ml-auto p-2 opacity-60 hover:opacity-100 transition-opacity"
            aria-label="Toggle navigation"
            aria-expanded="false"
          >
            <svg id="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:none">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>

        </div>

        <!-- Mobile nav dropdown (hidden by default) -->
        <nav id="mobile-nav" class="sm:hidden hidden">
          <ul class="flex flex-col pt-2 pb-1">
            {
              navBarLinks.map((link) => (
                <li>
                  <a
                    class="block px-2 py-3 text-sm rounded-lg hover:bg-gray-bg opacity-60 hover:opacity-100 transition-all"
                    href={link.url}
                    target={link.external ? "_blank" : "_self"}
                  >
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="flex gap-4 px-2 py-3 border-t border-white/10">
            {
              socialLinks.map((link) => (
                <a
                  href={link.url}
                  target={link.external ? "_blank" : "_self"}
                  class="block p-2 opacity-60 hover:opacity-100 transition-opacity"
                  aria-label={link.title}
                >
                  <Icon name={link.icon} width={20} height={20} />
                </a>
              ))
            }
          </div>
        </nav>

      </div>
    </header>
    <main class="mb-32">
      <slot />
    </main>
    <footer></footer>

    <!-- Lightbox overlay -->
    <div id="lightbox" style="display:none" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/90 p-4">
      <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none select-none cursor-pointer px-2">&#8249;</button>
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg cursor-zoom-out" />
      <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none select-none cursor-pointer px-2">&#8250;</button>
    </div>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap");

  html {
    font-family: "Inter", sans-serif;
    background: #000000;
  }

  * {
    -webkit-font-smoothing: antialiased;
    color: white;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  .hover-underline {
    text-decoration: underline 1px rgba(0, 0, 0, 0);
    text-underline-offset: 5px;
    transition: text-decoration-color 300ms;
  }

  .post:hover .hover-underline {
    text-decoration-color: rgba(255, 255, 255, 1);
  }

  article img {
    cursor: zoom-in;
  }
</style>
