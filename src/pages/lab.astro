---
import Layout from "../layouts/Layout.astro";
import { projectsPageContent } from "../config";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const labPosts = posts.filter(
  (p) => p.data.type === "project" || p.data.tags?.includes("project"),
);

// Sort by datePosted descending (when the post was added to the blog).
// Falls back to pubDate for older posts that predate the datePosted field.
const sortedLabPosts = [...labPosts].sort((a, b) => {
  const aDate = a.data.datePosted ?? a.data.pubDate;
  const bDate = b.data.datePosted ?? b.data.pubDate;
  const diff = bDate.getTime() - aDate.getTime();
  if (diff !== 0) return diff;
  // Tiebreak by pubDate so same-day posts sort newer project first
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
---

<Layout seo={projectsPageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6">
    <h1 class="font-bold text-3xl mb-1">The Lab</h1>
    <p class="opacity-60 mb-10">{projectsPageContent.subtitle}</p>
    <div class="grid grid-cols-1 group">
      {
        // MERGED: Static projects from config + Dynamic projects from Content Collection
        [
          ...projectsPageContent.projects,
          ...sortedLabPosts.map((p) => ({
            title: p.data.title,
            description: p.data.description,
            image: p.data.image.url.src,
            year: p.data.pubDate.getFullYear().toString(),
            url: `${import.meta.env.BASE_URL}/thinking/${p.id}`,
          })),
        ].map((project) => <ProjectCard {...project} />)
      }
    </div>
  </section>
</Layout>
