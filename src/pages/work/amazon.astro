---
import Layout from "../../layouts/Layout.astro";
import { identity } from "../../config";
import SocialLinkBox from "../../components/SocialLinkBox.astro";
import { socialLinks } from "../../config";

const seo = {
  title: "Amazon -- Program Management -- Technical | Ezra Stjärna-Shively",
  description:
    "Global Technical Program Manager II at Amazon - Global Technical Programs in Automation, AI, Process Engineering, and Ops Tech.",
  image: identity.logo,
};
---

<Layout seo={seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6">
    <h1 class="font-bold text-3xl mb-1">Amazon -- Program Management -- Technical</h1>
    <p class="opacity-60 mb-10">
      Global Technical Program Manager II | AI/ML Automation | Process Engineering | Operations Technology
    </p>

    <div class="flex items-center gap-4 mb-6">
      <img
        src="/superlite_v2/assets/amazon-logo.jpg"
        alt="Amazon"
        width={60}
        height={60}
        class="rounded w-[60px] h-[60px] object-contain bg-white"
      />
      <div>
        <h2 class="font-semibold text-xl">Amazon</h2>
        <p class="opacity-60">Mar 2020 – Present · 6 yrs · Full-time</p>
        <p class="opacity-60 text-sm">Seattle, Washington, United States · Remote</p>
      </div>
    </div>

    <p class="mb-10 opacity-80">
      Technical program leader who architected AI/ML-enabled automation systems serving 1M+ Amazon sellers — removing 600,000+ labor hours over 5 years while delivering $17M budget impact across a 2,200-person organization.
    </p>

    <div class="space-y-8 mb-10">
      <div>
        <p class="text-sm font-semibold opacity-80 mb-3">AI/ML IMPLEMENTATION</p>
        <ul class="space-y-2 text-sm opacity-60 list-disc pl-5">
          <li>First person in 2,200-person org to leverage AWS Bedrock (Claude, Titan) for advanced statistical modeling; diagnosed capacity planning problem that defeated every prior approach for 5+ years, cutting forecasting error rate from 29% down to under 5%</li>
          <li>Eliminated duplicate idea submissions to global change management intake program (23.7% to 11.0%): built AI system that surfaced existing matches to submitters before entry, removing the need for any human review of redundant intakes</li>
          <li>Prevented $4.6M in duplicate reimbursements (2023) + $4M annually: identified single misalignment between nationwide FC receiving practices and support operations SOPs, drove standardization across 25 teams</li>
          <li>Lifted invoice QA scores from 90.2% to 99%, improved reimbursement accuracy by 18%, and eliminated 19,556 annual labor hours: built and deployed analyzer to process complex foreign-language FBA seller invoices across 15 marketplaces</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold opacity-80 mb-3">PROGRAM LEADERSHIP AT SCALE</p>
        <ul class="space-y-2 text-sm opacity-60 list-disc pl-5">
          <li>Founded AIS (Amazon's first structured frontline-to-executive feedback loop), scaling from 2-person pilot to 22-person global engine spanning 5 regions and 2 external franchises, serving 1M+ Amazon sellers</li>
          <li>Drove $17M budget impact, prevented $8.6M cost leakage, architected systems running 386,000 automated cases/year without human intervention</li>
          <li>Increased AIS throughput 50% YoY while reducing team from 22 to 8 FTE: continuously automated core workflows as technology matured</li>
          <li>Lifted seller contact response rate from 9% to 88% and eliminated 200,000 annual wait-hours: identified legacy mandatory 2-day response delay in support SOPs with no documented business justification and drove its removal across multiple teams</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold opacity-80 mb-3">SYSTEMS THINKING</p>
        <ul class="space-y-2 text-sm opacity-60 list-disc pl-5">
          <li>Architect end-to-end distributed systems; partner with L7 engineers to scope SDE-weeks and define API integration points</li>
          <li>Map human + technical systems to find intervention points</li>
          <li>Organizations at scale: cross-org stakeholder alignment, influence without authority, operations technology</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold opacity-80 mb-3">ADDITIONAL</p>
        <ul class="space-y-2 text-sm opacity-60 list-disc pl-5">
          <li>Amazon Bar Raiser, 4-year internal leadership mentor, working board member</li>
          <li>Founder: Shively Endowed Scholarship Fund in Columbus, Ohio</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mt-16 max-w-2xl mx-auto px-6 sm:flex sm:gap-16">
    <h2 class="mb-8 sm:mb-0 opacity-60">Connect</h2>
    <div>
      <div class="mb-6">
        <p>Interested in discussing automation, process engineering, or technical program management? Connect on LinkedIn. For consulting engagements, reach out at armyofme@ezrashively.com.</p>
      </div>
      <div class="grid grid-cols-2 gap-2 group">
        {socialLinks.map((item) => <SocialLinkBox {...item} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  const amazonPhoneLink = document.querySelector('main a[href^="tel:"]') as HTMLAnchorElement | null;
  if (amazonPhoneLink) {
    const amazonLabel = amazonPhoneLink.querySelector('p');
    amazonPhoneLink.addEventListener('click', (e) => {
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (!isMobile && amazonLabel) {
        e.preventDefault();
        navigator.clipboard.writeText('+1 (415) 335-9911').then(() => {
          const original = amazonLabel.textContent;
          amazonLabel.textContent = 'Copied!';
          setTimeout(() => { amazonLabel.textContent = original; }, 2000);
        });
      }
    });
  }
</script>
