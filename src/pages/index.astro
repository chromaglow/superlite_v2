    </svg>
    <p class="opacity-60 mb-6">{homePageContent.role}</p>
    <div class="relative group w-fit mb-6">
      <Image
        src={identity.logo}
        alt={identity.name}
        width={100}
        height={100}
        densities={[1, 2, 3]}
        class="rounded-full shrink-0 object-cover min-w-[100px] w-[100px] h-[100px]"
      />
      <div class="absolute left-[110px] top-0 w-72 bg-black/80 text-white text-sm rounded-lg px-4 py-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none z-10">
        Good design should be as little design as possible. I believe the best solutions work so seamlessly that people don't even notice them. They just work. That's how I approach global program management: building systems that drive efficiency without creating friction.
      </div>
    </div>
    <p class="max-w-2xl mb-2">
      {homePageContent.description}
    </p>
    <p class="text-sm opacity-60 mt-2 mb-6">Currently exploring Director TPM, VP Technical Operations, and Senior Program Management roles in Seattle.</p>
    <div class="flex items-center gap-4 group w-fit mb-8">
      {
        homePageContent.links.map((link) => (
          <Link text={link.title} href={link.url} external={link.external} />
        ))
      }
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-6 mb-8">
      <div>
        <p class="text-2xl font-bold">600K+</p>
        <p class="text-xs opacity-60 mt-1">Labor Hours Removed</p>
      </div>
      <div>
        <p class="text-2xl font-bold">$8.6M</p>
        <p class="text-xs opacity-60 mt-1">Cost Leakage Prevented</p>
      </div>
      <div>
        <p class="text-2xl font-bold">200K+</p>
        <p class="text-xs opacity-60 mt-1">Seller Wait Hours Eliminated</p>
      </div>
      <div>
        <p class="text-2xl font-bold">386K</p>
        <p class="text-xs opacity-60 mt-1">Cases Automated</p>
      </div>
      <div>
        <p class="text-2xl font-bold">9%</p>
        <p class="text-xs opacity-60 mt-1">Operating Cost Ratio</p>
      </div>
      <div>
        <p class="text-2xl font-bold">5M+</p>
        <p class="text-xs opacity-60 mt-1">Contacts Served</p>
      </div>
    </div>
  </section>
  <section class="mt-20 max-w-2xl mx-auto px-6">
    <h2 class="mb-8">Recent Lab Projects & Thinking</h2>
    <div class="grid grid-cols-1 gap-10 sm:gap-6 mb-10">
      {
        posts.map((post) => (
          <a
            href={`${import.meta.env.BASE_URL}/thinking/${post.id}`}
            class=" sm:flex sm:flex-row-reverse sm:justify-between sm:gap-6 post"
          >
            <Image
              src={post.data.image.url}
              alt={post.data.image.alt}
              width={100}
              height={100}
              densities={[1, 2, 3]}
              class={"rounded-lg w-[100px] h-[100px] object-cover"}
            />
            <div class="mt-4 sm:my-auto">
              <p class="opacity-60 mb-2">
                {post.data.pubDate.toLocaleDateString()}
              </p>
              <h3 class="font-medium hover-underline">{post.data.title}</h3>
              <p class="text-sm opacity-60 mt-2 mb-3">
                {post.data.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="text-center">
      <a
        href={`${import.meta.env.BASE_URL}/thinking`}
        class="underline underline-offset-4 opacity-60 hover:opacity-100 transition-opacity"
        >View all</a
      >
    </div>
  </section>
</Layout>
