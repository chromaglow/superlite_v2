---
import { workWithMePageContent } from "../config";
const { seo, opening, services, background, cta } = workWithMePageContent;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/superlite_v2/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image" content={seo.image} />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── WHITE SECTION ── */
    #hero {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 130px 48px;
    }

    /* ── DIVIDER ── */
    #divider {
      width: 100%;
      height: 1px;
      background: #000;
    }

    /* ── BLACK SECTION ── */
    #content {
      background: #000;
      color: #fff;
      padding: 30px 48px 160px;
    }

    #content-inner {
      max-width: 680px;
      margin: 0 auto;
    }

    /* Intro block */
    .intro {
      margin-bottom: 54px;
    }

    .intro-headline {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #666;
      margin-bottom: 0;
    }

    .intro-principle {
      font-size: 28px;
      font-weight: 300;
      line-height: 1.35;
      color: #fff;
      margin-bottom: 32px;
      letter-spacing: -0.01em;
    }

    .intro-body {
      font-size: 15px;
      font-weight: 400;
      line-height: 1.75;
      color: #999;
      max-width: 540px;
    }

    .intro-body p { margin-bottom: 16px; }
    .intro-body p:last-child { margin-bottom: 0; }

    /* Method list */
    .method {
      margin-top: 20px;
      margin-bottom: 40px;
    }

    .method-item {
      font-size: 15px;
      font-weight: 400;
      line-height: 1.75;
      color: #666;
      padding: 4px 0;
    }

    /* Services */
    .services-label {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #444;
      margin-bottom: 48px;
    }

    .service {
      margin-bottom: 36px;
    }

    .service:last-child {
      margin-bottom: 0;
    }

    .service-title {
      font-size: 18px;
      font-weight: 400;
      color: #fff;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
      line-height: 1.3;
    }

    .service-body {
      font-size: 14px;
      font-weight: 400;
      line-height: 1.8;
      color: #666;
      max-width: 520px;
      text-wrap: pretty;
    }

    /* ── CONTACT ICONS ── */
    .intro-header {
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      gap: 20px;
      margin-bottom: 32px;
    }

    .contact-icons {
      display: flex;
      gap: 20px;
      flex-shrink: 0;
    }

    .contact-icon {
      color: #fff;
      opacity: 0.35;
      cursor: pointer;
      transition: opacity 0.2s ease;
      text-decoration: none;
      display: flex;
      align-items: center;
    }

    .contact-icon:hover {
      opacity: 1;
    }

    /* ── CTA ── */
    .cta {
      margin-top: 36px;
      padding-top: 36px;
      border-top: 0.5px solid #222;
    }

    .cta-label {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #444;
      margin-bottom: 28px;
    }

    .cta-number {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 32px;
      font-weight: 300;
      color: #fff;
      letter-spacing: -0.02em;
      text-decoration: none;
      margin-bottom: 10px;
    }

    .cta-number svg {
      flex-shrink: 0;
      opacity: 0.5;
    }

    .cta-sublabel {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.06em;
      color: #555;
      padding-left: 46px;
    }

    /* ── SVG NAME — responsive ── */
    #namesvg {
      width: min(557px, 88vw);
      height: auto;
    }

    /* ── MOBILE ── */
    @media (max-width: 600px) {
      #hero {
        padding: 72px 32px;
      }

      #content {
        padding: 18px 24px 100px;
      }

      .intro-principle {
        font-size: 22px;
      }

      .cta-number {
        font-size: 24px;
        gap: 10px;
      }

      .cta-sublabel {
        padding-left: 34px;
      }
    }
  </style>
</head>
<body>

  <!-- WHITE / NAME SECTION -->
  <section id="hero">
    <svg id="namesvg" viewBox="-21.2 0 636.0 66.462" fill="#000" style="overflow:visible">
