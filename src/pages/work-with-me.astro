      <path opacity="0" id="f-e"          transform="translate(-1.7, 0)"  d="M288.789,31.755v5.977h-22.898c.072,4.392,3.672,8.064,8.137,8.137h14.761v6.192h-14.761c-7.849-.144-14.185-6.553-14.329-14.329v-6.193c.144-7.849,6.48-14.329,14.545-14.329s14.545,6.48,14.545,14.545ZM265.891,31.539h16.706c-.072-4.536-3.744-8.208-8.353-8.208s-8.281,3.672-8.353,8.208Z"/>
