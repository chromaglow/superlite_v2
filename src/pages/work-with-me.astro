  </section>

  <!-- DIVIDER -->
  <div id="divider"></div>

  <!-- BLACK SECTION -->
  <section id="content">
    <div id="content-inner">

      <div class="intro">
        <div class="intro-header">
          <p class="intro-headline">Let's Collaborate</p>
          <div class="contact-icons">
            <a class="contact-icon" id="header-phone" href={cta.phoneHref} title="Call or text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.06 6.06l1.27-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </a>
            <a class="contact-icon" href="mailto:chromaglow@gmail.com" title="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m2 7 10 7 10-7"/>
              </svg>
            </a>
          </div>
        </div>
        <p class="intro-principle">{opening[0]}</p>
        <div class="intro-body">
          <p>{opening[1]}</p>
          <p set:html={background}></p>
        </div>
        <div class="method">
          {opening.slice(2).map((beat) => (
            <div class="method-item">{beat}</div>
          ))}
        </div>
      </div>

      <p class="services-label">Services</p>

      {services.map((service) => (
        <div class="service">
          <p class="service-title">{service.title}</p>
          <p class="service-body" set:html={service.description}></p>
        </div>
      ))}

      <div class="cta">
        <p class="cta-label">Get in touch</p>
        <a class="cta-number" id="cta-phone" href={cta.phoneHref}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.06 6.06l1.27-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {cta.phone}
        </a>
        <p class="cta-sublabel" id="cta-sublabel">{cta.label}</p>
      </div>

    </div>
  </section>

  <script>
  // ── Settings ─────────────────────────────────────────────────
  const FADE_MS   = 3800;
  const SPREAD_MS = 5000;
  const VAR_LEVEL = 8;
  const DEPTH     = 80;
  const SPEED_MS  = 5000;
  const INTERVAL  = 15000;

  const CENTER    = 296;

  const allForms = [
    'f-i-body','f-j-body','f-hyphen','f-l','f-t','f-z','f-v','f-y',
    'f-E','f-r','f-r2','f-h','f-n','f-S1','f-S2','f-a1','f-a2',
    'f-e','f-a-uml-body','f-i-dot','f-j-dot','f-a-dot1','f-a-dot2'
  ];

  const formPos: Record<string, number> = {
    'f-E':14,'f-z':52,'f-r':74,'f-a1':100,'f-S1':157,'f-h':191,
    'f-i-body':217,'f-v':246,'f-e':274,'f-l':300,'f-y':326,
    'f-hyphen':357,'f-S2':391,'f-t':423,'f-j-body':444,
    'f-a-uml-body':468,'f-r2':510,'f-n':540,'f-a2':579
  };

  const bodyForms = Object.keys(formPos);
  const dotForms  = ['f-i-dot','f-j-dot','f-a-dot1','f-a-dot2'];

  function rand(min: number, max: number) { return min + Math.random() * (max - min); }

  function setOpacity(id: string, val: number, transitionMs: number) {
    const el = document.getElementById(id);
    if (!el) return;
    if (transitionMs > 0) {
      el.style.transition = 'none';
      void el.getBoundingClientRect();
      el.style.transition = 'opacity ' + transitionMs + 'ms ease';
    } else {
      el.style.transition = 'none';
    }
    el.style.opacity = String(val);
    el.setAttribute('opacity', String(val));
  }

  function buildOrder() {
    const sorted = [...bodyForms].sort((a, b) =>
      Math.abs(formPos[b] - CENTER) - Math.abs(formPos[a] - CENTER)
    );
    const win = Math.round((VAR_LEVEL / 10) * (sorted.length - 1));
    const arr = [...sorted];
    for (let p = 0; p < 4; p++) {
      for (let i = 0; i < arr.length; i++) {
        const lo = Math.max(0, i - win);
        const hi = Math.min(arr.length - 1, i + win);
        const j  = Math.floor(rand(lo, hi + 0.999));
        if (j !== i) [arr[i], arr[j]] = [arr[j], arr[i]];
      }
    }
    return arr;
  }

  const flickGen: Record<string, number>   = {};
  let   flickTimers: ReturnType<typeof setTimeout>[] = [];

  function fadeDot(el: Element, from: number, to: number, ms: number, gen: number, id: string, onDone?: () => void) {
    const t0 = performance.now();
    function step(now: number) {
      if (flickGen[id] !== gen) return;
      const p = Math.min((now - t0) / ms, 1);
      const e = p < 0.5 ? 2*p*p : -1+(4-2*p)*p;
      el.setAttribute('opacity', (from + (to - from) * e).toFixed(4));
      if (p < 1) requestAnimationFrame(step);
      else if (onDone) onDone();
    }
    requestAnimationFrame(step);
  }

  function flickerDot(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const gen   = flickGen[id] || 0;
    const minOp = 1 - DEPTH / 100;
    const wait  = rand(INTERVAL * 0.7, INTERVAL * 1.4);
    const t = setTimeout(() => {
      if (flickGen[id] !== gen) return;
      el.style.removeProperty('opacity');
      el.style.removeProperty('transition');
      fadeDot(el, 1, minOp, SPEED_MS, gen, id, () => {
        fadeDot(el, minOp, 1, SPEED_MS, gen, id, () => {
          el.setAttribute('opacity', '1');
          const t2 = setTimeout(() => flickerDot(id), 100);
          flickTimers.push(t2);
        });
      });
    }, wait);
    flickTimers.push(t);
  }

  function startFlicker() {
    flickTimers.forEach(clearTimeout);
    flickTimers = [];
    dotForms.forEach(id => {
      flickGen[id] = (flickGen[id] || 0) + 1;
      const t = setTimeout(() => flickerDot(id), rand(0, INTERVAL * 0.9));
      flickTimers.push(t);
    });
  }

  window.addEventListener('load', () => {
    const contentEl = document.getElementById('content')!;
    const dividerEl = document.getElementById('divider')!;
    contentEl.style.opacity = '0';
    dividerEl.style.opacity = '0';

    setTimeout(() => {
      allForms.forEach(id => setOpacity(id, 0, 0));
      requestAnimationFrame(() => requestAnimationFrame(() => {
        const durVar  = (VAR_LEVEL / 10) * FADE_MS * 0.4;
        const order   = buildOrder();
        const stagger = SPREAD_MS / order.length;
        let lastFinish = 0;

        order.forEach((id, i) => {
          const jitter = rand(-stagger*0.3, stagger*0.3) * (VAR_LEVEL / 10);
          const start  = 200 + i * stagger + jitter;
          const dur    = FADE_MS + rand(-durVar, durVar);
          if (start + dur > lastFinish) lastFinish = start + dur;
          setTimeout(() => setOpacity(id, 1, dur), start);
        });

        const dotGap = SPREAD_MS * 0.6 + 200;
        dotForms.forEach((id, i) => {
          const start = dotGap + i * 200 + rand(-80, 80) * (VAR_LEVEL / 10);
          const dur   = FADE_MS + rand(-durVar * 0.5, durVar * 0.5);
          if (start + dur > lastFinish) lastFinish = start + dur;
          setTimeout(() => setOpacity(id, 1, dur), start);
        });

        setTimeout(() => {
          contentEl.style.transition = 'opacity 2500ms ease';
          dividerEl.style.transition = 'opacity 2500ms ease';
          contentEl.style.opacity = '1';
          dividerEl.style.opacity = '1';
        }, lastFinish * 0.5);

        setTimeout(startFlicker, lastFinish + 600);
      }));
    }, 600);
  });

  // ── Copy to clipboard (desktop) ────────────────────────────────
  const isMobile = () => /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  const ctaPhone = document.getElementById('cta-phone') as HTMLAnchorElement;
  const ctaSublabel = document.getElementById('cta-sublabel');
  if (ctaPhone && ctaSublabel) {
    ctaPhone.addEventListener('click', (e) => {
      if (!isMobile()) {
        e.preventDefault();
        navigator.clipboard.writeText('+1 (415) 335-9911').then(() => {
          ctaSublabel.textContent = 'Copied!';
          setTimeout(() => { ctaSublabel.textContent = 'Call or text'; }, 2000);
        });
      }
    });
  }

  const headerPhone = document.getElementById('header-phone') as HTMLAnchorElement;
  if (headerPhone) {
    headerPhone.addEventListener('click', (e) => {
      if (!isMobile()) {
        e.preventDefault();
        navigator.clipboard.writeText('+1 (415) 335-9911').then(() => {
          const rect = headerPhone.getBoundingClientRect();
          const tip = document.createElement('span');
          tip.textContent = 'Copied!';
          tip.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${rect.left + rect.width / 2}px;transform:translateX(-50%);background:#333;color:#fff;font-size:12px;padding:3px 8px;border-radius:4px;pointer-events:none;z-index:9999;transition:opacity 0.3s`;
          document.body.appendChild(tip);
          setTimeout(() => { tip.style.opacity = '0'; }, 1500);
          setTimeout(() => { tip.remove(); }, 1800);
        });
      }
    });
  }
  </script>

</body>
</html>
